# Steel OS image settings (STEEL-16). Read by the Justfile and the workflows.

# Name of the image. Becomes ghcr.io/rodger-roberts-dev/steel-os
IMAGE_NAME=steel-os

# GitHub user or organisation that owns the repo and the image
REPO_ORGANIZATION="rodger-roberts-dev"

IMAGE_DESC="Steel OS: a Linux for everyday people that plays everything, built on Bazzite. A Steel & Code project in partnership with Blackbox Entertainment."
IMAGE_KEYWORDS="bootc,bazzite,fedora,kde,plasma,gaming,steel-os"

# Logo shown on registries and artifacthub.io
IMAGE_LOGO_URL="https://steel-os.org/assets/icon-256.png"

# Tag that "the current Steel OS" always points at
DEFAULT_TAG="latest"

# Tool that turns the image into an ISO and virtual machine disks
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
