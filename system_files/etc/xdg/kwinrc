# Steel OS window manager defaults for KDE Plasma (STEEL-29, decision 5.1).
# Windows cascade like Windows instead of tiling. Users can change this in
# System Settings > Window Management > Window Behavior > Advanced.

[Windows]
Placement=Cascade
# Focus follows a click, like Windows.
FocusPolicy=ClickToFocus

[Plugins]
# Show the Overview on Meta+Alt+Space (see kglobalshortcutsrc).
overviewEnabled=true
# Screen zoom for Meta+Ctrl+Z.
zoomEnabled=true

# Steel OS (STEEL-29): four virtual desktops in one row, for S&C's
# Super+1..4 (switch) and Super+Shift+1..4 (move window) shortcuts.
[Desktops]
Number=4
Rows=1
