[Desktop Entry]
Name=Steel OS Portal
GenericName=Welcome and One-Click Apps
Comment=Set up Steel OS and install apps in one click
Exec=yafti_gtk.py /usr/share/steel-os/portal.yml
Icon=steel-os
Terminal=false
Type=Application
Categories=System;Settings;
Keywords=steel;setup;apps;install;welcome;portal;
StartupWMClass=io.github.ublue_os.yafti_gtk
X-GNOME-Autostart-enabled=true
