// Steel OS (T, 2026-10-18): "Update now" in the Steel OS Portal starts the
// same update the Tuesday timer runs (uupd.service), without a password, for
// an administrator sitting at the computer. Starting it is all this allows:
// the update only accepts Steel OS images signed with the Steel OS key.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "uupd.service" || action.lookup("unit") == "uupd-manual.service") &&
        action.lookup("verb") == "start" &&
        subject.active && subject.local && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
