#!/usr/bin/bash
# Steel OS: "Report a problem or idea". Opened from the start menu and the
# Steel OS Portal (Welcome tab).
#
# Takes a screenshot of the screen as it was, then one window: Problem or
# Idea, a title, what happened, and two ticks (include the screenshot, include
# the computer details listed in the window). "See screenshot" opens it first.
# Send posts it to steel-os.org/api/report, which files it in the Steel OS
# team's private tracker and answers with a reference number. Nothing is sent
# without clicking Send, and no account is needed. An email or Discord name is
# optional (only so the team can ask a question). Each report carries the
# installation's anonymous ID, so someone who abuses reports can be banned
# without anyone having to sign up (T, 2026-10-23; see install_id below).

set -uo pipefail

TITLE="Report a problem or idea"
ENDPOINT="${STEEL_OS_REPORT_URL:-https://steel-os.org/api/report}"
SITE="${STEEL_OS_SITE:-https://steel-os.org}"
# Every report sent from this PC, with its private key, for My reports.
STORE="${XDG_STATE_HOME:-$HOME/.local/state}/steel-os/reports.json"
remember_report() { # key token title kind
    mkdir -p "$(dirname "$STORE")"
    [[ -s "$STORE" ]] || echo '[]' > "$STORE"
    jq --arg k "$1" --arg t "$2" --arg s "$3" --arg kind "$4" --arg d "$(date +%Y-%m-%d)" \
        '. + [{key: $k, token: $t, title: $s, kind: $kind, date: $d}]' "$STORE" > "$STORE.tmp" && mv "$STORE.tmp" "$STORE"
    chmod 0600 "$STORE"
}
WORK="${XDG_RUNTIME_DIR:-/tmp}/steel-os-report"
# The installation's anonymous ID: the PC's random machine ID, hashed with this
# app's own name so it matches nothing else and can't be turned back into it
# (the way systemd recommends using the machine ID). A reinstall gives a new one.
install_id() {
    [[ -r /etc/machine-id ]] || return 0
    printf 'steel-os-report:%s' "$(tr -d '[:space:]' < /etc/machine-id)" | sha256sum | cut -c1-32
}
SHOT="$WORK/screenshot.png"

command -v yad >/dev/null 2>&1 || { xdg-open https://steel-os.org/report; exit 0; }
msg() { kdialog --title "$TITLE" --icon tools-report-bug "$@" 2>/dev/null; }

mkdir -p "$WORK" && chmod 700 "$WORK"
rm -f "$SHOT"

# 1. The screenshot, before any window of ours is on screen (a moment for the
# start menu or the Portal button to close).
sleep 0.6
spectacle --background --nonotify --fullscreen --output "$SHOT" >/dev/null 2>&1 || true
have_shot=0
[[ -s "$SHOT" ]] && have_shot=1

# 2. Computer details: no names, no user name, no files.
details() {
    local image gpu mem cpu sb
    image="$(rpm-ostree status --booted --json 2>/dev/null | jq -r '.deployments[0]["container-image-reference"] // empty' 2>/dev/null)"
    gpu="$(lspci 2>/dev/null | grep -E 'VGA|3D|Display' | cut -d: -f3- | sed 's/^ *//' | paste -sd ';' -)"
    mem="$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')"
    cpu="$(lscpu 2>/dev/null | sed -n 's/^Model name: *//p' | head -1)"
    sb="$(mokutil --sb-state 2>/dev/null | head -1)"
    printf 'Steel OS: %s\n' "$(cat /usr/share/steel-os/version 2>/dev/null || echo unknown)"
    printf 'Build: %s\n' "$(cat /usr/share/steel-os/build 2>/dev/null || echo unknown)"
    [[ -n "$image" ]] && printf 'Image: %s\n' "$image"
    printf 'Kernel: %s\n' "$(uname -r)"
    printf 'Desktop: %s, %s\n' "$(plasmashell --version 2>/dev/null || echo Plasma)" "${XDG_SESSION_TYPE:-unknown}"
    [[ -n "$cpu" ]] && printf 'Processor: %s\n' "$cpu"
    [[ -n "$mem" ]] && printf 'Memory: %s\n' "$mem"
    [[ -n "$gpu" ]] && printf 'Graphics: %s\n' "$gpu"
    [[ -n "$sb" ]] && printf 'Secure Boot: %s\n' "$sb"
    printf 'Model: %s %s\n' "$(cat /sys/devices/virtual/dmi/id/sys_vendor 2>/dev/null)" "$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null)"
}
DETAILS="$(details)"

escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$1"; }

kind="Problem"; title=""; text=""; contact=""; use_shot=TRUE; use_details=TRUE
(( have_shot )) || use_shot=FALSE
problem=""
# What is attached: the screenshot taken just now, or the pictures the user
# chose instead (screenshots they took, phone photos of the screen); several
# at once (T, 2026-10-21), 6 at most, 5 MB each.
SHOTS=(); auto_only=0
(( have_shot )) && { SHOTS=("$SHOT"); auto_only=1; }
shot_label="the screenshot taken when you clicked"
MAX_SHOTS=6
mime_of() { case "${1,,}" in *.jpg|*.jpeg) echo image/jpeg ;; *) echo image/png ;; esac; }
pick_picture() {
    local f chosen=() added=0
    # The first choice replaces the automatic screenshot; later ones add to it.
    mapfile -t chosen < <(kdialog --title "Choose pictures" --multiple --separate-output \
        --getopenfilename "$HOME/Pictures" "image/png image/jpeg|Pictures (PNG, JPEG)" 2>/dev/null)
    (( ${#chosen[@]} )) || return 1
    (( auto_only )) && { SHOTS=(); auto_only=0; }
    problem=""
    for f in "${chosen[@]}"; do
        [[ -n "$f" && -r "$f" ]] || continue
        case "${f,,}" in *.jpg|*.jpeg|*.png) ;; *) problem="Only PNG or JPEG pictures, please; $(basename "$f") was left out."; continue ;; esac
        if (( $(stat -c %s "$f" 2>/dev/null || echo 0) > 5000000 )); then
            problem="$(basename "$f") is too large (5 MB at most) and was left out."; continue
        fi
        if (( ${#SHOTS[@]} >= MAX_SHOTS )); then problem="Six pictures at most; the rest were left out."; break; fi
        local dup=0 s; for s in "${SHOTS[@]}"; do [[ "$s" == "$f" ]] && dup=1; done
        (( dup )) || { SHOTS+=("$f"); added=1; }
    done
    (( ${#SHOTS[@]} )) && { have_shot=1; use_shot=TRUE; } || { have_shot=0; use_shot=FALSE; }
    shot_label="$(for s in "${SHOTS[@]}"; do basename "$s"; done | paste -sd ', ' -)"
    (( ${#SHOTS[@]} > 1 )) && shot_label="${#SHOTS[@]} pictures: $shot_label"
    return 0
}

while true; do
    intro="<big><b>Report a problem or idea</b></big>

Tell the Steel OS team what went wrong, or what you would like. It goes straight to the team; no account needed.

<b>Computer details</b> (no names, no files):
<small>$(escape "$DETAILS")</small>"
    if (( have_shot )); then
        intro+="

<b>Picture:</b> $(escape "$shot_label"). Click <b>Choose pictures</b> to send other screenshots or photos instead; pick several at once if you like."
    else
        intro+="

<i>No screenshot could be taken. Click <b>Choose pictures</b> to attach some.</i>"
    fi
    [[ -n "$problem" ]] && intro+="

<span foreground='#F2641E'><b>$(escape "$problem")</b></span>"

    combo="Problem!Idea"
    [[ "$kind" == "Idea" ]] && combo="Problem!^Idea"
    [[ "$kind" == "Problem" ]] && combo="^Problem!Idea"

    buttons=(--button="Cancel:1")
    (( have_shot )) && buttons+=(--button="See pictures:2")
    buttons+=(--button="Choose pictures:3" --button="Send:0")

    # --always-print-result: the typed text comes back for See / Choose too, so
    # it is still there when the window reopens (it was lost, T, 2026-10-21).
    out="$(yad --form --title="$TITLE" --window-icon=tools-report-bug --image=tools-report-bug \
        --center --width=680 --height=640 --borders=16 --separator=$'\x1f' --item-separator='!' \
        --always-print-result \
        --text="$intro" \
        --field="This is a:CB" "$combo" \
        --field="Title" "$title" \
        --field="What happened, or what would you like?:TXT" "$text" \
        --field="How can we reach you? (optional, an email or Discord name, only to ask you something)" "$contact" \
        --field="Include the pictures:CHK" "$use_shot" \
        --field="Include the computer details:CHK" "$use_details" \
        "${buttons[@]}")"
    rc=$?
    [[ $rc -eq 0 || $rc -eq 2 || $rc -eq 3 ]] || exit 0

    IFS=$'\x1f' read -r kind title text contact use_shot use_details _ <<< "$out"
    text="$(printf '%s' "$text" | sed 's/\\n/\n/g')"

    if [[ $rc -eq 2 ]]; then
        for s in "${SHOTS[@]}"; do xdg-open "$s" >/dev/null 2>&1 & done
        problem=""
        continue
    fi
    if [[ $rc -eq 3 ]]; then
        pick_picture || true
        continue
    fi

    problem=""
    if [[ ${#title} -lt 3 ]]; then problem="Please give it a short title."; continue; fi
    if [[ ${#text} -lt 5 ]]; then problem="Please say a little more about it."; continue; fi

    args=(-sS --max-time 90 -F "kind=$([[ "$kind" == "Idea" ]] && echo idea || echo problem)"
          -F "title=<-" -F "website=")
    # Text goes through files so quotes, semicolons and new lines arrive as typed.
    printf '%s' "$text" > "$WORK/description.txt"
    args+=(-F "description=<$WORK/description.txt")
    printf '%s' "$contact" > "$WORK/contact.txt"
    args+=(-F "contact=<$WORK/contact.txt" -F "install_id=$(install_id)")
    if [[ "$use_details" == "TRUE" ]]; then
        printf '%s' "$DETAILS" > "$WORK/details.txt"
        args+=(-F "details=<$WORK/details.txt")
    fi
    if [[ "$use_shot" == "TRUE" && $have_shot -eq 1 ]]; then
        for s in "${SHOTS[@]}"; do args+=(-F "screenshot=@$s;type=$(mime_of "$s")"); done
    fi

    answer="$(printf '%s' "$title" | curl "${args[@]}" "$ENDPOINT" 2>/dev/null)"
    ok="$(jq -r '.ok // false' <<< "$answer" 2>/dev/null)"
    if [[ "$ok" == "true" ]]; then
        key="$(jq -r '.key // empty' <<< "$answer")"
        token="$(jq -r '.token // empty' <<< "$answer")"
        if [[ -n "$key" && -n "$token" ]]; then
            remember_report "$key" "$token" "$title" "$([[ "$kind" == "Idea" ]] && echo idea || echo problem)"
            if msg --yes-label "See it" --no-label "OK" --yesno "<h3>Thank you!</h3><p>Your report reached the Steel OS team. Its reference is <b>$key</b>.</p><p>Follow it and reply to the team under <b>My reports</b> in the Steel OS Portal, or open it now.</p>"; then
                xdg-open "$SITE/my-report?key=$key&token=$token" >/dev/null 2>&1 &
            fi
        else
            msg --msgbox "<h3>Thank you!</h3><p>Your report reached the Steel OS team.${key:+ Its reference is <b>$key</b>.}</p>"
        fi
        rm -rf "$WORK"
        exit 0
    fi
    error="$(jq -r '.error // empty' <<< "$answer" 2>/dev/null)"
    problem="${error:-The report could not be sent. Check the internet connection, then click Send again.}"
done
