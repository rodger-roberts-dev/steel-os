#!/usr/bin/bash
# Steel OS (STEEL-36): run the password reset if the login screen asked for it.
#
# The login screen's "Forgot your password?" link writes a request note into
# /var/lib/steel-os/recovery-request (writable only by the login screen and
# root) and restarts the PC. At boot this runs before the login screen. If the
# note is there, it is deleted at once and the reset window opens full screen
# on this PC's own display: graphical in a kiosk session (cage), or text mode
# on the console if that can't start. Nothing happens without the note.

set -uo pipefail

REQUEST=/var/lib/steel-os/recovery-request/request
UI=/usr/libexec/steel-os-recovery-reset-ui

[[ -e "$REQUEST" ]] || exit 0
rm -f "$REQUEST"

plymouth quit 2>/dev/null || true

export XDG_RUNTIME_DIR=/run/steel-os-reset
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
export QT_QPA_PLATFORM=wayland
export XDG_CURRENT_DESKTOP=KDE

# The reset window, full screen in a kiosk (cage). First with the graphics
# card; if that can't start (a VM without 3D, an unusual card), again with
# software drawing, which works on any screen (T, 2026-10-19: a VirtualBox VM
# with 3D off got a screen of errors instead of the reset window).
export WLR_NO_HARDWARE_CURSORS=1
if command -v cage >/dev/null 2>&1; then
    if cage -s -- "$UI" gui; then
        exit 0
    fi
    echo "steel-os-recovery-reset: the graphics card couldn't start the kiosk; trying software drawing"
    if WLR_RENDERER=pixman cage -s -- "$UI" gui; then
        exit 0
    fi
    echo "steel-os-recovery-reset: the kiosk couldn't start; using text mode"
fi

# Last resort: text mode, drawn on the console itself (not the log).
export TERM=linux
chvt 1 2>/dev/null || true
clear > /dev/tty1 2>/dev/null || true
"$UI" text < /dev/tty1 > /dev/tty1 2>&1
clear > /dev/tty1 2>/dev/null || true
exit 0
