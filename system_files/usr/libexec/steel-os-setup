#!/usr/bin/bash
# Steel OS (STEEL-35): first-login setup, like Windows, with Skip on every page.
#
# 1. Security questions   2. Welcome   3. Updates   4. Problems and ideas
# 5. Choose apps   6. Printers   7. Done
#
# The security questions come first (T, 2026-10-18), so a way back in after
# a forgotten password is set up before anything else; Skip moves on.
#
# Runs once per user at first login (autostart from /etc/skel). "Steel OS
# Setup" in the start menu runs it again with --again. Uses kdialog, KDE's own
# dialog tool, so it looks like the rest of the desktop. Chosen apps install
# from Flathub in the background; a notification says when they are ready.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/steel-os"
STAMP="$STATE_DIR/setup.done"
APPS_LIST=/usr/share/steel-os/steel-apps.txt
TITLE="Steel OS Setup"

if [[ "${1:-}" != "--again" && -f "$STAMP" ]]; then
    exit 0
fi
# Mark it done before showing anything, so a crash or a closed window never
# makes it reappear at every login.
mkdir -p "$STATE_DIR"
: > "$STAMP"

command -v kdialog >/dev/null 2>&1 || exit 0

dialog() {
    kdialog --title "$TITLE" --icon steel-os "$@"
}

open_portal() {
    nohup setsid yafti_gtk.py /usr/share/steel-os/portal.yml >/dev/null 2>&1 &
}

# --- 1. Security questions (STEEL-36), optional ------------------------
if [[ -x /usr/libexec/steel-os-recovery-setup ]]; then
    /usr/libexec/steel-os-recovery-setup --from-setup || true
fi

# --- 2. Welcome ------------------------------------------------------------
dialog --yes-label "Next" --no-label "Skip setup" --yesno \
"<h2>Welcome to Steel OS</h2>
<p>A few more quick steps get your computer ready: how updates work, how to
tell us about a problem, your apps and your printer.</p>
<p>Every step can be skipped. You can run this setup again any time from
the start menu: <b>Steel OS Setup</b>.</p>" || exit 0

# --- 3. Updates ------------------------------------------------------------
dialog --yes-label "Next" --no-label "Skip the rest" --yesno \
"<h2>Updates look after themselves</h2>
<p>Steel OS updates itself every <b>Tuesday morning</b> in the background.
The new version starts the next time you restart.</p>
<p>The version before is always kept. If anything ever goes wrong after an
update, restart and pick the earlier version from the menu.</p>
<p>Want an update sooner? Open the <b>Steel OS Portal</b> and click
<b>Update now</b>.</p>" || exit 0

# --- 4. Problems and ideas -------------------------------------------------
dialog --yes-label "Next" --no-label "Skip the rest" --yesno \
"<h2>Something wrong? Got an idea?</h2>
<p>Tell the Steel OS team straight from your computer: open
<b>Report a Problem or Idea</b> in the start menu, or in the
<b>Steel OS Portal</b>, Welcome tab.</p>
<p>Say what happened or what you would like, and it sends a screenshot and
your computer details (no names, no files) with it. You see the screenshot
first and can leave it out. No account needed.</p>" || exit 0

# --- 5. Choose apps --------------------------------------------------------
# Popular picks are ticked to start with; untick anything you don't want.
PRESELECT=" com.google.Chrome com.slack.Slack us.zoom.Zoom com.discordapp.Discord "
if [[ -r "$APPS_LIST" ]]; then
    items=()
    while IFS='|' read -r app_id name description category; do
        app_id="${app_id//[[:space:]]/}"
        [[ -z "$app_id" || "$app_id" == \#* ]] && continue
        name="$(echo "$name" | sed 's/^ *//;s/ *$//')"
        description="$(echo "$description" | sed 's/^ *//;s/ *$//')"
        category="$(echo "$category" | sed 's/^ *//;s/ *$//')"
        if flatpak info "$app_id" >/dev/null 2>&1; then
            continue
        fi
        state=off
        [[ "$PRESELECT" == *" $app_id "* ]] && state=on
        items+=("$app_id" "$category: $name. $description" "$state")
    done < "$APPS_LIST"

    if [[ ${#items[@]} -gt 0 ]]; then
        chosen="$(dialog --separate-output --geometry 720x560 \
            --checklist "<h2>Choose your apps</h2><p>Tick the apps you want. They install in the background while you carry on, and appear in the start menu when ready. You can add more later from the Steel OS Portal or the App Store.</p>" \
            "${items[@]}")" && status=0 || status=$?
        if [[ $status -eq 0 && -n "$chosen" ]]; then
            mapfile -t picked <<< "$chosen"
            count=${#picked[@]}
            notify-send --app-name="Steel OS" --icon=steel-os \
                "Installing $count apps" "They appear in the start menu as each one finishes." || true
            nohup setsid bash -c '
                failed=()
                for app in "$@"; do
                    flatpak install --system --noninteractive flathub "$app" || failed+=("$app")
                done
                if [[ ${#failed[@]} -eq 0 ]]; then
                    notify-send --app-name="Steel OS" --icon=steel-os "Your apps are ready" "Find them in the start menu."
                else
                    notify-send --app-name="Steel OS" --icon=steel-os "Some apps did not install" "Try them again from the Steel OS Portal: ${failed[*]}"
                fi
            ' steel-os-setup-apps "${picked[@]}" >/dev/null 2>&1 &
        fi
    fi
fi

# --- 6. Printers -----------------------------------------------------------
if dialog --yes-label "Set up a printer now" --no-label "Later" --yesno \
"<h2>Printers</h2>
<p>Most printers are found when you click <b>Add</b> on the Printers page.
Older HP, Canon and Epson printers use drivers that are already built in.</p>
<p>You can do this any time from System Settings, Printers.</p>"; then
    nohup setsid systemsettings kcm_printer_manager >/dev/null 2>&1 &
fi

# --- 7. Done ---------------------------------------------------------------
if dialog --yes-label "Open the Steel OS Portal" --no-label "Finish" --yesno \
"<h2>You're all set</h2>
<p><b>Apps:</b> the start menu, the Steel OS Portal on the taskbar, or the App Store.<br>
<b>Settings:</b> System Settings in the start menu.<br>
<b>Help:</b> Steel OS Help in the start menu.<br>
<b>Problems or ideas:</b> Report a Problem or Idea in the start menu.<br>
<b>Updates and tools:</b> the Steel OS Portal.<br>
<b>Terminal:</b> Super+Enter. <b>Browser:</b> Super+Shift+Enter.</p>"; then
    open_portal
fi
exit 0
