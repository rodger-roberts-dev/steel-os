#!/usr/bin/bash
# Steel OS (STEEL-29): apply the Steel OS keyboard shortcuts to this user.
#
# Plasma does not read shortcut defaults from /etc/xdg, so new users get
# them from /etc/skel/.config/kglobalshortcutsrc, and this script brings
# existing users up to date once per shortcut-file version. It writes only
# the keys Steel OS defines; anything else the user set is left alone.
# Safe to run more than once.

set -euo pipefail

# Users created before Steel OS removed Bazzite Portal still have their own
# copy of its autostart entry; remove it (STEEL-31). Harmless if absent.
rm -f "$HOME/.config/autostart/bazzite-portal.desktop"

# Pin the Steel OS Portal on the taskbar, once, for people whose desktop
# existed before the portal arrived (STEEL-40). This runs before Plasma starts,
# so Plasma reads the change at login. It only adds the pin, next to the
# terminal, and never removes anything. New users get the pin from the
# default layout.
APPLETS="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
PIN_STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/steel-os/portal-pin.done"
if [[ -f "$APPLETS" && ! -f "$PIN_STAMP" ]]; then
    if ! grep -q "steel-os-portal\.desktop" "$APPLETS"; then
        sed -i -E '/^launchers=./{ s#(applications:org\.kde\.konsole\.desktop)#\1,applications:steel-os-portal.desktop#; t; s#$#,applications:steel-os-portal.desktop# }' "$APPLETS"
    fi
    mkdir -p "$(dirname "$PIN_STAMP")"
    : > "$PIN_STAMP"
fi

SRC=/usr/share/steel-os/kglobalshortcutsrc
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/steel-os"
STAMP="$STATE_DIR/shortcuts.done"
[[ -r "$SRC" ]] || exit 0

VERSION="$(sha256sum "$SRC" | cut -d ' ' -f 1)"
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$VERSION" ]]; then
    exit 0
fi

KWRITE="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
[[ -n "$KWRITE" ]] || exit 0

groups=()
while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == \[* ]]; then
        # "[services][org.kde.konsole.desktop]" -> ("services" "org.kde.konsole.desktop")
        inner="${line#[}"
        inner="${inner%]}"
        IFS=$'\x1f' read -r -a groups <<< "${inner//][/$'\x1f'}"
        continue
    fi
    key="${line%%=*}"
    value="${line#*=}"
    args=()
    for g in "${groups[@]}"; do
        args+=(--group "$g")
    done
    "$KWRITE" --file kglobalshortcutsrc "${args[@]}" --key "$key" -- "$value"
done < "$SRC"

# This runs before KWin starts (steel-os-shortcuts.service), and Plasma reads
# the shortcuts when KWin starts, so nothing needs restarting.

mkdir -p "$STATE_DIR"
printf '%s\n' "$VERSION" > "$STAMP"
