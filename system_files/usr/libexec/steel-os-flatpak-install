#!/usr/bin/bash
# Steel OS (STEEL-17): install the default apps (Flatpaks from Flathub) once.
#
# Runs as a system service after every boot. It reads the list the image
# ships in /usr/share/steel-os/flatpaks-default.txt, installs anything
# missing, and records a fingerprint of the list. On later boots it exits at
# once unless the list changed in a new image. Safe to run as often as you
# like; it never removes anything a user installed.
#
# Bazzite's own bazzite-flatpak-manager runs first and sets up Flathub and
# the Firefox and LibreOffice permissions; this script only adds our apps.

set -euo pipefail

LIST="/usr/share/steel-os/flatpaks-default.txt"
STAMP_DIR="/etc/steel-os"
STAMP="$STAMP_DIR/flatpaks-default.done"

if [[ ! -r "$LIST" ]]; then
    echo "Steel OS: no default app list at $LIST, nothing to do."
    exit 0
fi

# Drop comments and blank lines; one Flatpak ID per line.
mapfile -t WANTED < <(grep -Ev '^[[:space:]]*(#|$)' "$LIST" | tr -d '[:space:]' | sort -u)
if [[ ${#WANTED[@]} -eq 0 ]]; then
    echo "Steel OS: default app list is empty, nothing to do."
    exit 0
fi

FINGERPRINT=$(printf '%s\n' "${WANTED[@]}" | sha256sum | cut -d ' ' -f 1)
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$FINGERPRINT" ]]; then
    echo "Steel OS: default apps already installed for this list."
    exit 0
fi

# Make sure Flathub exists even if Bazzite's manager has not run yet.
flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# Firefox first: it is the default browser, and links open nowhere without
# it. Then each app on its own, so one failed download never blocks the rest.
ORDERED=()
for app in "${WANTED[@]}"; do
    [[ "$app" == org.mozilla.firefox ]] && ORDERED=("$app" "${ORDERED[@]}") || ORDERED+=("$app")
done

echo "Steel OS: installing ${#ORDERED[@]} default apps from Flathub."
FAILED=()
for app in "${ORDERED[@]}"; do
    if flatpak info --system "$app" >/dev/null 2>&1; then
        continue
    fi
    if ! flatpak install --system --noninteractive flathub "$app"; then
        echo "Steel OS: could not install $app this time; will retry." >&2
        FAILED+=("$app")
    fi
done

# Leave the stamp unwritten if anything failed, so the service runs again
# (it retries every two minutes, and at every boot).
if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo "Steel OS: still to install: ${FAILED[*]}" >&2
    exit 1
fi

mkdir -p "$STAMP_DIR"
printf '%s\n' "$FINGERPRINT" > "$STAMP"
echo "Steel OS: default apps done."
