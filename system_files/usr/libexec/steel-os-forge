#!/usr/bin/bash
# Steel OS: one-click install of Steel & Code Forge, the terminal-first agent
# platform (STEEL-25). Optional, never installed by default.
#
#   steel-os-forge install     install or update Forge for this user
#   steel-os-forge uninstall   remove Forge (asks before removing the saved key)
#   steel-os-forge update      update Forge if it is installed (quiet; daily)
#   steel-os-forge launch      open Forge in a terminal (asks for the key once)
#   steel-os-forge set-key     save or change the OpenRouter key
#   steel-os-forge status      prints "installed" or "not-installed"
#
# Forge is pure Python (3.11 or newer, no outside dependencies), so it goes in
# its own private Python environment in this user's home. Nothing is added to
# the system. Its OpenRouter key is kept in the desktop's password store
# (KWallet, through the Secret Service), never in a file.

set -euo pipefail

SOURCE_FILE=/usr/share/steel-os/forge-source
HOME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/steel-and-code-forge"
VENV="$HOME_DIR/venv"
BIN="$HOME/.local/bin/forge"
DESKTOP="${XDG_DATA_HOME:-$HOME/.local/share}/applications/steel-and-code-forge.desktop"
KEY_ATTRS=(service steel-and-code-forge key openrouter)

say() { kdialog --title "Steel & Code Forge" "$@" 2>/dev/null || true; }

source_spec() {
    local spec=""
    [[ -r "$SOURCE_FILE" ]] && spec="$(grep -Ev '^\s*(#|$)' "$SOURCE_FILE" | head -1 | tr -d '[:space:]')"
    if [[ -z "$spec" ]]; then
        echo "Steel & Code Forge isn't published yet. Check back after the next Steel OS update." >&2
        exit 1
    fi
    echo "$spec"
}

get_key() { secret-tool lookup "${KEY_ATTRS[@]}" 2>/dev/null || true; }

set_key() {
    local key
    key="$(kdialog --title "Steel & Code Forge" --password \
        "Forge talks to AI models through OpenRouter.\n\nPaste your OpenRouter API key (from openrouter.ai, Keys).\nIt is kept in your password store, not in a file." 2>/dev/null)" || return 1
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    [[ -n "$key" ]] || return 1
    printf '%s' "$key" | secret-tool store --label "Steel & Code Forge: OpenRouter key" "${KEY_ATTRS[@]}"
    say --passivepopup "OpenRouter key saved." 4
}

install_forge() {
    local spec
    spec="$(source_spec)"
    echo "Installing Steel & Code Forge from: $spec"
    mkdir -p "$HOME_DIR" "$(dirname "$BIN")" "$(dirname "$DESKTOP")"
    [[ -x "$VENV/bin/python" ]] || python3 -m venv "$VENV"
    "$VENV/bin/python" -m pip install --quiet --upgrade pip
    "$VENV/bin/python" -m pip install --upgrade "$spec"

    # The forge command: reads the key from the password store for each run,
    # so it is never left in the shell's environment.
    cat > "$BIN" <<EOF
#!/usr/bin/bash
# Steel OS wrapper for Steel & Code Forge (installed by steel-os-forge).
if [[ -z "\${FORGE_OPENROUTER_API_KEY:-}" ]]; then
    FORGE_OPENROUTER_API_KEY="\$(secret-tool lookup ${KEY_ATTRS[*]} 2>/dev/null || true)"
    [[ -n "\$FORGE_OPENROUTER_API_KEY" ]] && export FORGE_OPENROUTER_API_KEY
fi
exec "$VENV/bin/forge" "\$@"
EOF
    chmod 0755 "$BIN"

    cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Steel & Code Forge
GenericName=AI agent platform
Comment=Terminal-first AI agents from Steel & Code
Exec=/usr/libexec/steel-os-forge launch
Icon=utilities-terminal
Terminal=false
Categories=Development;
Keywords=forge;ai;agent;byte;steel;code;
EOF
    echo
    echo "Forge is installed. Open it from the start menu (Steel & Code Forge) or type: forge"
}

uninstall_forge() {
    rm -rf "$VENV" "$BIN" "$DESKTOP"
    rmdir "$HOME_DIR" 2>/dev/null || true
    if [[ -n "$(get_key)" ]] && kdialog --title "Steel & Code Forge" \
        --yesno "Forge is removed.\n\nAlso remove your saved OpenRouter key?" 2>/dev/null; then
        secret-tool clear "${KEY_ATTRS[@]}" || true
    fi
    echo "Steel & Code Forge is removed."
}

launch() {
    if [[ ! -x "$BIN" ]]; then
        say --sorry "Steel & Code Forge isn't installed. Install it from the Steel OS Portal, Steel Apps, Developer."
        exit 1
    fi
    [[ -n "$(get_key)" ]] || set_key || true
    exec konsole --workdir "$HOME" -e bash -c \
        'echo "Steel & Code Forge"; echo; "$HOME/.local/bin/forge"; echo; echo "Type forge --help to see what it can do."; exec bash -l'
}

case "${1:-}" in
    install) install_forge ;;
    uninstall) uninstall_forge ;;
    update) [[ -x "$VENV/bin/python" ]] && "$VENV/bin/python" -m pip install --quiet --upgrade "$(source_spec)" || true ;;
    launch) launch ;;
    set-key) set_key ;;
    status) [[ -x "$BIN" ]] && echo installed || echo not-installed ;;
    *) echo "usage: steel-os-forge install|uninstall|update|launch|set-key|status" >&2; exit 2 ;;
esac
