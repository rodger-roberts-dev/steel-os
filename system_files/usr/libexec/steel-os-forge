#!/usr/bin/bash
# Steel OS: one-click install of Steel & Code Forge (STEEL-25), the
# terminal-first AI agent platform from Steel & Code. Optional, never
# installed by default.
#
#   steel-os-forge install     download Forge and run its own installer
#   steel-os-forge uninstall   remove Forge (asks before removing the saved key)
#   steel-os-forge update      reinstall the newest Forge quietly, if installed
#   steel-os-forge launch      open the Forge terminal interface
#   steel-os-forge status      prints "installed" or "not-installed"
#
# Steel OS doesn't install Forge its own way: it downloads Forge's source from
# the address in /usr/share/steel-os/forge-source and runs Forge's installer
# (scripts/install-forge.sh), which sets up a private Python environment, the
# forge command in ~/.local/bin, the OpenRouter key (a private file only this
# user can read) and, if wanted, the separate Hermes agent.

set -euo pipefail

SOURCE_FILE=/usr/share/steel-os/forge-source
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/steel-os-forge"
FORGE_DIR="$DATA/steel-and-code/forge"
FORGE_CONFIG="$CONFIG/steel-and-code/forge"
BIN="$HOME/.local/bin/forge"
DESKTOP="$DATA/applications/steel-and-code-forge.desktop"
WORKSPACE="$HOME/Projects"

source_url() {
    local url=""
    [[ -r "$SOURCE_FILE" ]] && url="$(grep -Ev '^\s*(#|$)' "$SOURCE_FILE" | head -1 | tr -d '[:space:]')"
    if [[ -z "$url" ]]; then
        echo "Steel & Code Forge isn't available yet. Check back after the next Steel OS update." >&2
        exit 1
    fi
    echo "$url"
}

fetch_source() {
    local url
    url="$(source_url)"
    rm -rf "$CACHE"
    mkdir -p "$CACHE/src"
    echo "Downloading Steel & Code Forge..."
    curl --proto '=https' --tlsv1.2 -fsSL "$url" | tar -xz -C "$CACHE/src" --strip-components=1
}

write_desktop() {
    mkdir -p "$(dirname "$DESKTOP")"
    cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Steel & Code Forge
GenericName=AI agents
Comment=Byte, Neighbor and the Forge terminal interface from Steel & Code
Exec=/usr/libexec/steel-os-forge launch
Icon=utilities-terminal
Terminal=false
Categories=Development;
Keywords=forge;ai;agent;byte;neighbor;hermes;steel;code;
EOF
}

install_forge() {
    fetch_source
    # Forge's own installer: asks for the OpenRouter key and offers Hermes.
    bash "$CACHE/src/scripts/install-forge.sh"
    write_desktop
    mkdir -p "$WORKSPACE"
    rm -rf "$CACHE"
    echo
    echo "Open it from the start menu: Steel & Code Forge."
}

update_forge() {
    [[ -x "$FORGE_DIR/venv/bin/python" ]] || return 0
    fetch_source
    # No terminal attached, so Forge's installer keeps the saved key and
    # doesn't ask about Hermes.
    bash "$CACHE/src/scripts/install-forge.sh" </dev/null >/dev/null
    rm -rf "$CACHE"
}

uninstall_forge() {
    rm -rf "$FORGE_DIR" "$DESKTOP" "$CACHE"
    # Only remove ~/.local/bin/forge if it is Forge's launcher.
    if [[ -f "$BIN" ]] && grep -q 'steel-and-code/forge' "$BIN"; then
        rm -f "$BIN"
    fi
    if [[ -d "$FORGE_CONFIG" ]]; then
        read -r -p "Also remove your saved OpenRouter key? [y/N]: " answer || answer=""
        if [[ "$answer" =~ ^[Yy] ]]; then
            rm -rf "$FORGE_CONFIG"
            echo "Key removed."
        else
            echo "Key kept in $FORGE_CONFIG"
        fi
    fi
    echo "Steel & Code Forge is removed. Hermes, if you installed it, is a separate program and stays."
}

launch() {
    if [[ ! -x "$BIN" ]]; then
        kdialog --title "Steel & Code Forge" --sorry \
            "Steel & Code Forge isn't installed. Install it from the Steel OS Portal: Steel Apps, Developer." 2>/dev/null || true
        exit 1
    fi
    mkdir -p "$WORKSPACE"
    exec konsole --workdir "$WORKSPACE" -e bash -c '
        if [[ ! -s "${XDG_CONFIG_HOME:-$HOME/.config}/steel-and-code/forge/openrouter.key" ]]; then
            echo "Forge needs your OpenRouter key (from openrouter.ai, Keys)."
            "$HOME/.local/bin/forge" setup-key || true
        fi
        "$HOME/.local/bin/forge" tui --workspace "$HOME/Projects"
        echo; echo "Forge closed. Type forge --help for more, or close this window."
        exec bash -l'
}

case "${1:-}" in
    install) install_forge ;;
    uninstall) uninstall_forge ;;
    update) update_forge ;;
    launch) launch ;;
    status) [[ -x "$FORGE_DIR/venv/bin/forge" ]] && echo installed || echo not-installed ;;
    *) echo "usage: steel-os-forge install|uninstall|update|launch|status" >&2; exit 2 ;;
esac
