#!/usr/bin/bash
# Steel OS: one-click app install, uninstall and open for the Steel OS Portal,
# in a small window instead of a terminal (T, 2026-10-19).
#
#   steel-os-app click APP_ID "Name"      one click in the Portal (T, 2026-10-19):
#                                         installs if it isn't installed, else a
#                                         window with Open, Uninstall and Close
#   steel-os-app install APP_ID "Name"
#   steel-os-app uninstall APP_ID "Name"
#   steel-os-app open APP_ID "Name"
#
# Apps come from Flathub, system-wide, like the App Store.

set -uo pipefail

action="${1:-}" app="${2:-}" name="${3:-${2:-the app}}"
TITLE="Steel OS Portal"
[[ "$app" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "usage: steel-os-app install|uninstall|open APP_ID NAME" >&2; exit 2; }

# A thick orange bar (/usr/share/steel-os/progress.css), when this yad can style.
STYLE=()
yad --help-all 2>/dev/null | grep -q -- '--css' && [[ -r /usr/share/steel-os/progress.css ]] \
    && STYLE=(--css=/usr/share/steel-os/progress.css)

installed() { flatpak info "$app" >/dev/null 2>&1; }
open_app() { nohup setsid flatpak run "$app" >/dev/null 2>&1 & }
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g' <<< "$1"; }

done_box() { # done_box "html" -> offers Open
    if yad --title="$TITLE" --window-icon=steel-os --image=steel-os --center --borders=16 --width=420 \
        --text="$1" --button="Close:1" --button="Open $name:0" 2>/dev/null; then
        open_app
    fi
}

# Runs flatpak with a moving bar and its latest step; leaves the exit code in $rc.
run_with_window() { # run_with_window "Installing Name" flatpak args...
    local heading="$1"; shift
    local verb="${heading%% *}"   # Installing / Uninstalling
    local log; log="$(mktemp)"
    # flatpak only prints its progress ("Installing 2/3… 45%") when it talks to
    # a terminal; written to a plain file it says nothing until the end, so the
    # bar sat empty on "Getting ready…" (T, 2026-10-21). script lends it a
    # terminal and keeps the output in the log.
    # (script, or Python's pty module when script isn't there.)
    if command -v script >/dev/null 2>&1; then
        ( script -qefc "$(printf '%q ' "$@")" "$log" >/dev/null 2>&1; echo $? > "$log.rc" ) &
    else
        ( python3 -c 'import pty, sys; sys.exit(pty.spawn(sys.argv[1:]))' "$@" >"$log" 2>&1; echo $? > "$log.rc" ) &
    fi
    local job=$!
    (
        # flatpak prints "Installing 2/3… ████ 45%": item 2 of 3 (the app and
        # what it needs), 45% of that item. The bar shows the whole job
        # (T, 2026-10-19: the same filling bar as Update now).
        local done_pct=0 item=1 items=1 p
        echo 0
        while kill -0 "$job" 2>/dev/null; do
            line="$(tr '\r' '\n' < "$log" | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' | grep -vE '^\s*$' | tail -1)"
            p="$(grep -oE '[0-9]{1,3}%' <<< "$line" | tail -1 | tr -d '%')"
            if [[ "$line" =~ ([0-9]+)/([0-9]+) ]]; then item=${BASH_REMATCH[1]}; items=${BASH_REMATCH[2]}; fi
            (( items < 1 )) && items=1
            if [[ -n "$p" ]]; then
                done_pct=$(( ( (item - 1) * 100 + p ) / items ))
                (( done_pct > 99 )) && done_pct=99
                echo "$done_pct"
                if (( items > 1 )); then echo "# $verb… part $item of $items, $done_pct%"; else echo "# $verb… $done_pct%"; fi
            else
                echo "# Getting ready…"
            fi
            sleep 0.5
        done
        echo 100
    ) | yad --progress "${STYLE[@]}" --percentage=0 --auto-close --no-buttons --center --width=440 --borders=16 \
            --title="$TITLE" --window-icon=steel-os --image=steel-os --text="<b>$heading</b>" 2>/dev/null &
    local win=$!
    wait "$job"; wait "$win" 2>/dev/null
    rc="$(cat "$log.rc" 2>/dev/null || echo 1)"
    out="$(tr '\r' '\n' < "$log" | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' | grep -vE '^\s*$' | tail -8)"
    rm -f "$log" "$log.rc"
}

case "$action" in
    click)
        if ! installed; then
            exec "$0" install "$app" "$name"
        fi
        yad --title="$TITLE" --window-icon=steel-os --image=steel-os --center --borders=16 --width=420 \
            --text="<b>$name is installed.</b>" \
            --button="Close:1" --button="Uninstall $name:2" --button="Open $name:0" 2>/dev/null
        case $? in
            0) open_app ;;
            2) exec "$0" uninstall "$app" "$name" ;;
        esac ;;
    install)
        if installed; then
            done_box "<b>$name is already installed.</b>\nFind it in the start menu."
            exit 0
        fi
        # -y answers the questions; --noninteractive would also silence the
        # progress, which is what kept the bar empty (T, 2026-10-22).
        run_with_window "Installing $name" flatpak install -y flathub "$app"
        # Flathub sometimes retires an app under a new name and installs that
        # instead ("end-of-life, in favor of app/NEW/..."). That is a success.
        renamed="$(grep -oE 'in favor of app/[^/ ]+' <<< "$out" | head -1 | sed 's#.*app/##')"
        if [[ "$rc" == 0 && -n "$renamed" ]] && flatpak info "$renamed" >/dev/null 2>&1; then
            app="$renamed"
            done_box "<b>$name is installed.</b>
Find it in the start menu. It updates itself."
            exit 0
        fi
        if [[ "$rc" == 0 ]] && installed; then
            done_box "<b>$name is installed.</b>\nFind it in the start menu. It updates itself."
        else
            yad --title="$TITLE" --window-icon=steel-os --image=dialog-warning --center --borders=16 --width=520 \
                --text="<b>$name couldn't be installed.</b>\nCheck the internet connection and try again. If it keeps failing, use <b>Report a Problem or Idea</b>.\n\n<small>$(esc "$out")</small>" \
                --button="Close:0" 2>/dev/null
        fi ;;
    uninstall)
        installed || { yad --title="$TITLE" --image=steel-os --center --borders=16 --text="<b>$name isn't installed.</b>" --button="Close:0" 2>/dev/null; exit 0; }
        yad --title="$TITLE" --window-icon=steel-os --image=dialog-question --center --borders=16 --width=420 \
            --text="<b>Uninstall $name?</b>\nYour own files stay where they are." \
            --button="Cancel:1" --button="Uninstall:0" 2>/dev/null || exit 0
        run_with_window "Uninstalling $name" flatpak uninstall -y "$app"
        if [[ "$rc" == 0 ]]; then
            notify-send --app-name="Steel OS" --icon=steel-os "$name was uninstalled" "Install it again any time from the Steel OS Portal." 2>/dev/null || true
        else
            yad --title="$TITLE" --image=dialog-warning --center --borders=16 --width=520 \
                --text="<b>$name couldn't be uninstalled.</b>\n\n<small>$(esc "$out")</small>" --button="Close:0" 2>/dev/null
        fi ;;
    open)
        if installed; then open_app
        else
            yad --title="$TITLE" --window-icon=steel-os --image=steel-os --center --borders=16 --width=420 \
                --text="<b>$name isn't installed yet.</b>" --button="Close:1" --button="Install $name:0" 2>/dev/null \
                && exec "$0" install "$app" "$name"
        fi ;;
    *) echo "usage: steel-os-app install|uninstall|open APP_ID NAME" >&2; exit 2 ;;
esac
